{% comment %}
  Overrides the theme's card: links straight to `file` if set (else to the
  item's page), labels it with `art` and shows `credit` (Markdown) below,
  outside the link. Links in `credit` starting with "/" get the baseurl.
{% endcomment %}
{% if project.file %}
  {% assign target = project.file | relative_url %}
{% else %}
  {% assign target = project.url | relative_url %}
{% endif %}
<div class="col">
  <div class="card h-100 hoverable">
    <a href="{{ target }}">
      {% if project.img %}
        {%
          include figure.liquid
          loading="eager"
          path=project.img
          sizes = "250px"
          alt=project.title
          class="card-img-top"
        %}
      {% endif %}
      <div class="card-body">
        {% if project.art %}<p class="card-art">{{ project.art }}</p>{% endif %}
        <h2 class="card-title">{{ project.title }}</h2>
        <p class="card-text">{{ project.description }}</p>
      </div>
    </a>
    {% if project.credit %}
      {% capture mit_baseurl %}]({{ site.baseurl }}/{% endcapture %}
      <div class="card-body card-credit">
        {{ project.credit | replace: "](/", mit_baseurl | markdownify }}
      </div>
    {% endif %}
  </div>
</div>
